---
interface Props {
  feed: 'Canonical Blog' | 'Ubuntu Blog';
}

const { feed } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium',
    feed === 'Canonical Blog'
      ? 'bg-aubergine/10 text-aubergine dark:bg-aubergine/40 dark:text-fuchsia-100'
      : 'bg-ubuntu-orange/10 text-[#c7431a] dark:bg-ubuntu-orange/25 dark:text-orange-100',
  ]}
>
  <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
  原文出處：{feed}
</span>
