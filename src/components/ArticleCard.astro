---
import SourceBadge from './SourceBadge.astro';
import TagList from './TagList.astro';
import type { Article } from '../lib/articles';
import { formatDate, isoDate } from '../lib/site';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { data } = article;
const href = `/articles/${article.id}/`;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-ubuntu-orange/50 hover:shadow-lg dark:border-white/10 dark:bg-white/[0.03]"
  data-article-card
  data-tags={JSON.stringify(data.tags)}
>
  <div class="h-1 bg-gradient-to-r from-ubuntu-orange to-aubergine"></div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center gap-1 rounded-full bg-ubuntu-orange px-2.5 py-0.5 text-xs font-medium text-white">
        🇹🇼 台灣觀點
      </span>
      <SourceBadge feed={data.sourceFeed} />
    </div>

    <h2 class="mt-4 text-xl font-bold leading-snug text-stone-900 dark:text-white">
      <a href={href} class="after:absolute after:inset-0 group-hover:text-ubuntu-orange">{data.title}</a>
    </h2>
    <p class="mt-1 font-mono text-sm text-stone-500 dark:text-stone-400" lang="en">{data.canonicalTitle}</p>

    <p class="mt-4 line-clamp-3 text-[0.95rem] leading-relaxed text-stone-700 dark:text-stone-300">{data.summary}</p>

    <blockquote class="mt-4 border-l-4 border-ubuntu-orange bg-ubuntu-orange-soft/60 px-4 py-2 text-sm leading-relaxed text-stone-800 dark:bg-ubuntu-orange/10 dark:text-stone-200">
      <span class="line-clamp-3">{data.taiwanTakeaway}</span>
    </blockquote>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-5">
      <div class="relative z-10"><TagList tags={data.tags} /></div>
      <time datetime={isoDate(data.pubDate)} class="text-xs text-stone-500 dark:text-stone-400">
        {formatDate(data.pubDate)}
      </time>
    </div>
  </div>
</article>
