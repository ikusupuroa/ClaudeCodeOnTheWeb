---
interface Props {
  takeaway: string;
}

const { takeaway } = Astro.props;
---

<aside
  class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-ubuntu-orange via-[#c7431a] to-aubergine p-6 text-white shadow-xl shadow-ubuntu-orange/20 md:p-8"
  aria-label="ikusupuroa 觀點核心引言"
>
  <svg class="pointer-events-none absolute -right-6 -top-6 h-40 w-40 text-white/10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M7.17 6A5.17 5.17 0 0 0 2 11.17V18h6.83v-6.83H5.41A1.76 1.76 0 0 1 7.17 9.4zm11.66 0a5.17 5.17 0 0 0-5.16 5.17V18h6.83v-6.83h-3.42a1.76 1.76 0 0 1 1.75-1.76z"></path>
  </svg>
  <p class="text-sm font-medium tracking-widest text-white/80">ikusupuroa 觀點｜MY TAKE</p>
  <p class="relative mt-3 text-lg font-medium leading-relaxed md:text-xl">{takeaway}</p>
  <a href="#my-take" class="relative mt-5 inline-flex items-center gap-1 text-sm text-white/85 underline-offset-4 hover:underline">
    閱讀完整觀點
    <span aria-hidden="true">↓</span>
  </a>
</aside>
