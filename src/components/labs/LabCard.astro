---
import LabBadges from './LabBadges.astro';
import TagList from '../TagList.astro';
import { itemDate, sectionHref, type LabItem } from '../../lib/labs';
import { formatDate, isoDate, withBase } from '../../lib/site';

interface Props {
  item: LabItem;
}

const { item } = Astro.props;
const date = itemDate(item);

const card =
  item.kind === 'single'
    ? {
        section: item.entry.section,
        href: withBase(sectionHref(item.entry.section, item.entry.slug)),
        title: item.entry.doc.data.title,
        summary: item.entry.doc.data.summary,
        tags: item.entry.doc.data.tags,
        product: 'product' in item.entry.doc.data ? item.entry.doc.data.product : undefined,
        seriesLabel: undefined,
        chapters: [],
      }
    : {
        section: item.series.section,
        href: withBase(sectionHref(item.series.section, item.series.slug)),
        title: item.series.data.title,
        summary: item.series.data.summary,
        tags: [...new Set(item.series.chapters.flatMap((c) => c.doc.data.tags))],
        product: undefined,
        seriesLabel: `系列｜${item.series.chapters.length} 章${item.series.data.status === 'completed' ? '・已完結' : '・連載中'}`,
        chapters: item.series.chapters.map((c) => ({ chapter: c.chapter!, title: c.doc.data.title })),
      };
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-(--lab-accent)/50 hover:shadow-lg dark:border-white/10 dark:bg-white/[0.03]"
>
  <div class="lab-hero h-1"></div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      <LabBadges section={card.section} product={card.product} seriesLabel={card.seriesLabel} />
    </div>

    <h2 class="mt-4 text-xl font-bold leading-snug text-stone-900 dark:text-white">
      <a href={card.href} class="after:absolute after:inset-0 group-hover:text-(--lab-accent-strong)">{card.title}</a>
    </h2>

    <p class="mt-3 line-clamp-3 text-[0.95rem] leading-relaxed text-stone-700 dark:text-stone-300">{card.summary}</p>

    {
      card.chapters.length > 0 && (
        <ol class="mt-4 space-y-1 border-l-2 border-(--lab-accent)/25 pl-4 text-sm text-stone-600 dark:border-white/15 dark:text-stone-300">
          {card.chapters.slice(0, 4).map((c) => (
            <li class="truncate">
              <span class="mr-2 font-mono text-(--lab-accent-strong)">{String(c.chapter).padStart(2, '0')}</span>
              {c.title}
            </li>
          ))}
          {card.chapters.length > 4 && <li class="text-stone-400">…還有 {card.chapters.length - 4} 章</li>}
        </ol>
      )
    }

    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-5">
      <TagList tags={card.tags} />
      <time datetime={isoDate(date)} class="text-xs text-stone-500 dark:text-stone-400">
        {item.kind === 'series' ? '最近更新' : '發表'} {formatDate(date)}
      </time>
    </div>
  </div>
</article>
