---
import { LAB_SECTIONS, type LabSectionKey } from '../../lib/labs';

interface Props {
  section: LabSectionKey;
  product?: string;
  /** 系列名稱或「系列｜共 N 章」等標示 */
  seriesLabel?: string;
}

const { section, product, seriesLabel } = Astro.props;
---

<span class="inline-flex items-center gap-1 rounded-full bg-(--lab-accent) px-2.5 py-0.5 text-xs font-medium text-white">
  {LAB_SECTIONS[section].label}
</span>
{
  product && (
    <span class="inline-flex items-center rounded-full bg-(--lab-soft) px-2.5 py-0.5 font-mono text-xs font-medium text-(--lab-accent-strong)">
      {product}
    </span>
  )
}
{
  seriesLabel && (
    <span class="inline-flex items-center gap-1.5 rounded-full border border-(--lab-accent)/40 px-2.5 py-0.5 text-xs font-medium text-(--lab-accent-strong)">
      <span class="h-1.5 w-1.5 rounded-full bg-current" />
      {seriesLabel}
    </span>
  )
}
