---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, countTags, HOME_ARTICLE_LIMIT } from '../lib/articles';
import { SITE, withBase } from '../lib/site';
import { getLabContent, LAB_SECTIONS, type LabSectionKey } from '../lib/labs';

const articles = await getArticles();
const tags = countTags(articles);
const latest = articles.slice(0, HOME_ARTICLE_LIMIT);
const allHref = withBase('/articles/');

// 首頁底部的「動手實作」入口卡：每個單元顯示篇數與最新一篇
const labs = await Promise.all(
  (['notes', 'packages'] as LabSectionKey[]).map(async (key) => {
    const { items } = await getLabContent(key);
    const latestItem = items[0];
    return {
      meta: LAB_SECTIONS[key],
      count: items.length,
      latest: latestItem && {
        title: latestItem.kind === 'single' ? latestItem.entry.doc.data.title : latestItem.series.data.title,
      },
    };
  }),
);
---

<BaseLayout>
  <section class="relative overflow-hidden bg-aubergine-deep text-white">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_20%,rgba(233,84,32,0.45),transparent_45%),radial-gradient(circle_at_10%_90%,rgba(119,33,111,0.7),transparent_50%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-4 pb-24 pt-20 sm:px-6 md:pb-32 md:pt-28">
      <p class="font-mono text-sm tracking-widest text-ubuntu-orange-light">UBUNTU NOTES BY IKUSUPUROA</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight md:whitespace-nowrap md:text-5xl lg:text-6xl">
        {SITE.title}
      </h1>
      <div class="mt-6 space-y-1 text-lg leading-relaxed text-white/80 md:text-xl">
        {SITE.intro.map((line) => <p class="lg:whitespace-nowrap">{line}</p>)}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#articles"
          class="rounded-full bg-ubuntu-orange px-6 py-2.5 font-medium text-white shadow-lg shadow-ubuntu-orange/30 transition hover:bg-ubuntu-orange-light"
        >
          瀏覽最新導讀
        </a>
        <a href={withBase('/about/')} class="rounded-full border border-white/30 px-6 py-2.5 font-medium text-white/90 transition hover:bg-white/10">
          關於我
        </a>
      </div>
      <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4 text-sm text-white/60">
        <div>
          <dt>已發布導讀</dt>
          <dd class="text-2xl font-bold text-white">{articles.length}</dd>
        </div>
        <div>
          <dt>追蹤官方來源</dt>
          <dd class="text-2xl font-bold text-white">2</dd>
        </div>
        <div>
          <dt>技術主題</dt>
          <dd class="text-2xl font-bold text-white">{tags.length}</dd>
        </div>
      </dl>
    </div>

    <a
      href="#articles"
      class="scroll-hint absolute bottom-5 left-1/2 flex h-11 w-11 -translate-x-1/2 items-center justify-center rounded-full border border-white/30 text-white/80 transition hover:border-ubuntu-orange hover:bg-ubuntu-orange hover:text-white"
      aria-label="往下捲到最新精華導讀"
      title="往下看最新文章"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"></path>
      </svg>
    </a>
  </section>

  <section id="articles" class="mx-auto max-w-6xl scroll-mt-16 px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-2xl font-bold md:text-3xl">最新精華導讀</h2>
        <p class="mt-2 text-stone-600 dark:text-stone-400">每篇都有我的觀點，也附上 Canonical 官方原文出處。</p>
      </div>
      <a href={allHref} class="shrink-0 font-medium text-ubuntu-orange hover:underline">全部文章 →</a>
    </div>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label="依標籤瀏覽">
      {
        tags.map(([tag, count]) => (
          <a
            href={withBase(`/articles/?tag=${encodeURIComponent(tag)}`)}
            class="rounded-full border border-stone-300 px-4 py-1.5 text-sm transition hover:border-ubuntu-orange hover:text-ubuntu-orange dark:border-white/20"
          >
            #{tag} <span class="opacity-60">{count}</span>
          </a>
        ))
      }
    </nav>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {latest.map((article) => <ArticleCard article={article} />)}
    </div>

    <div class="mt-10 text-center">
      <a
        href={allHref}
        class="inline-flex items-center gap-2 rounded-full border-2 border-ubuntu-orange px-6 py-2.5 font-medium text-ubuntu-orange transition hover:bg-ubuntu-orange hover:text-white"
      >
        查看全部 {articles.length} 篇文章 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section id="labs" class="mx-auto max-w-6xl scroll-mt-16 px-4 pb-4 pt-6 sm:px-6">
    <div>
      <h2 class="text-2xl font-bold md:text-3xl">動手實作</h2>
      <p class="mt-2 text-stone-600 dark:text-stone-400">不只讀官方消息，也實際操作一次，附上步驟與畫面。</p>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        labs.map(({ meta, count, latest }) => (
          <a
            href={withBase(meta.path)}
            class="group relative flex flex-col overflow-hidden rounded-2xl bg-aubergine-deep p-6 text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg md:p-8"
          >
            <div
              class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_100%_0%,rgba(233,84,32,0.35),transparent_55%)]"
              aria-hidden="true"
            />
            <p class="relative font-mono text-sm tracking-widest text-ubuntu-orange-light">{meta.eyebrow}</p>
            <h3 class="relative mt-2 text-2xl font-bold group-hover:text-ubuntu-orange-light">{meta.label}</h3>
            <p class="relative mt-3 leading-relaxed text-white/75">{meta.description}</p>
            <p class="relative mt-6 border-t border-white/15 pt-4 text-sm text-white/70">
              {latest ? (
                <>
                  最新：<span class="text-white">{latest.title}</span>
                  <span class="ml-2 text-white/50">共 {count} 篇</span>
                </>
              ) : (
                <span class="inline-flex items-center gap-2">
                  <span class="rounded-full bg-ubuntu-orange px-2.5 py-0.5 text-xs font-medium text-white">即將推出</span>
                  第一篇正在實作中
                </span>
              )}
            </p>
            <span class="relative mt-4 font-medium text-ubuntu-orange-light">
              前往{meta.navLabel} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  // 舊版首頁的 ?tag= 連結，轉到全部文章頁的同一個篩選
  const tag = new URLSearchParams(window.location.search).get('tag');
  if (tag) {
    window.location.replace(`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/articles/?tag=${encodeURIComponent(tag)}`);
  }
</script>

<style>
  @keyframes scroll-hint-bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }
  .scroll-hint {
    animation: scroll-hint-bounce 2s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
    }
  }
</style>
