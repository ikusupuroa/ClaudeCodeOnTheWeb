---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, countTags } from '../lib/articles';
import { SITE, withBase } from '../lib/site';

const articles = await getArticles();
const tags = countTags(articles);
---

<BaseLayout>
  <section class="relative overflow-hidden bg-aubergine-deep text-white">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_20%,rgba(233,84,32,0.45),transparent_45%),radial-gradient(circle_at_10%_90%,rgba(119,33,111,0.7),transparent_50%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <p class="font-mono text-sm tracking-widest text-ubuntu-orange-light">CANONICAL × UBUNTU × TAIWAN</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">
        {SITE.nameZh}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl">
        {SITE.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#articles"
          class="rounded-full bg-ubuntu-orange px-6 py-2.5 font-medium text-white shadow-lg shadow-ubuntu-orange/30 transition hover:bg-ubuntu-orange-light"
        >
          瀏覽最新導讀
        </a>
        <a href={withBase('/about/')} class="rounded-full border border-white/30 px-6 py-2.5 font-medium text-white/90 transition hover:bg-white/10">
          策展理念
        </a>
      </div>
      <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4 text-sm text-white/60">
        <div>
          <dt>已發布導讀</dt>
          <dd class="text-2xl font-bold text-white">{articles.length}</dd>
        </div>
        <div>
          <dt>追蹤官方來源</dt>
          <dd class="text-2xl font-bold text-white">2</dd>
        </div>
        <div>
          <dt>技術主題</dt>
          <dd class="text-2xl font-bold text-white">{tags.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="articles" class="mx-auto max-w-6xl scroll-mt-16 px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-2xl font-bold md:text-3xl">最新精華導讀</h2>
        <p class="mt-2 text-stone-600 dark:text-stone-400">每篇皆附「🇹🇼 台灣觀點點評」與 Canonical 官方原文出處。</p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-2" role="toolbar" aria-label="依標籤篩選" data-tag-filter>
      <button
        type="button"
        data-tag=""
        aria-pressed="true"
        class="tag-btn rounded-full border border-stone-300 px-4 py-1.5 text-sm transition dark:border-white/20"
      >
        全部 <span class="opacity-60">{articles.length}</span>
      </button>
      {
        tags.map(([tag, count]) => (
          <button
            type="button"
            data-tag={tag}
            aria-pressed="false"
            class="tag-btn rounded-full border border-stone-300 px-4 py-1.5 text-sm transition dark:border-white/20"
          >
            #{tag} <span class="opacity-60">{count}</span>
          </button>
        ))
      }
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2" data-article-grid>
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>

    <p class="mt-10 hidden text-center text-stone-500" data-empty-state>此標籤目前沒有文章。</p>
  </section>
</BaseLayout>

<style>
  .tag-btn:hover {
    border-color: var(--color-ubuntu-orange);
    color: var(--color-ubuntu-orange);
  }
  .tag-btn[aria-pressed='true'] {
    border-color: var(--color-ubuntu-orange);
    background-color: var(--color-ubuntu-orange);
    color: #fff;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tag-filter] [data-tag]');
  const cards = document.querySelectorAll<HTMLElement>('[data-article-card]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

  function applyFilter(tag: string) {
    let visible = 0;
    cards.forEach((card) => {
      const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
      const show = !tag || tags.includes(tag);
      card.hidden = !show;
      if (show) visible++;
    });
    buttons.forEach((btn) => btn.setAttribute('aria-pressed', String((btn.dataset.tag ?? '') === tag)));
    emptyState?.classList.toggle('hidden', visible > 0);
  }

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? '';
      const url = new URL(window.location.href);
      if (tag) url.searchParams.set('tag', tag);
      else url.searchParams.delete('tag');
      history.replaceState(null, '', url);
      applyFilter(tag);
    }),
  );

  const initial = new URLSearchParams(window.location.search).get('tag') ?? '';
  const known = [...buttons].some((btn) => btn.dataset.tag === initial);
  applyFilter(known ? initial : '');
</script>
