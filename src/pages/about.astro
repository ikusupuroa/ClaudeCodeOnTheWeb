---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../lib/site';

const reasons = [
  {
    title: '長期支援，升級有節奏',
    body: 'LTS 版本每兩年一版，標準支援 5 年，搭配 Ubuntu Pro（含 Legacy add-on）最長可到 15 年。正式環境不必追著版本跑，可以按自己的節奏規劃升級。',
  },
  {
    title: '安全修補跟得上',
    body: '從本站整理的 PHP、curl、憑證外洩等事件可以看到，Ubuntu 會為所有支援中的版本釋出修補，還有預設開啟的自動安全更新。',
  },
  {
    title: '從筆電到雲端都是同一套',
    body: '桌機、伺服器、主要公有雲、Kubernetes 與邊緣裝置都能跑 Ubuntu，學一次就能用在很多地方。',
  },
  {
    title: '開源，而且一直在進步',
    body: '從 Rust 改寫的核心工具、後量子密碼，到在本機執行的語音輸入 Myna，每個版本都看得到新東西。',
  },
];

const workflow = [
  { step: '01', who: '自動', title: '監控官方消息', body: 'GitHub Actions 每小時檢查 Canonical Blog 與 Ubuntu Blog，有新文章就開 Issue 通知我。' },
  { step: '02', who: 'ikusupuroa', title: '挑選主題', body: '我從清單中挑出值得分享的文章，略過純活動公告或重複的內容。' },
  { step: '03', who: 'Claude Code', title: 'AI 協作撰稿', body: 'Claude Code 閱讀官方原文，整理成繁體中文導讀與觀點初稿；查不到的內容會標註「待確認」。' },
  { step: '04', who: 'ikusupuroa', title: '上線後檢查', body: '文章通過建置檢查後直接上線，我再逐篇確認；有問題就修改或下架。' },
];
---

<BaseLayout title="關於我" description={`關於 ${SITE.name}：一個 Ubuntu 使用者，以及這個網站怎麼運作。`}>
  <section class="bg-aubergine-deep text-white">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <p class="font-mono text-sm tracking-widest text-ubuntu-orange-light">ABOUT ME</p>
      <h1 class="mt-3 text-3xl font-bold md:text-5xl">嗨，我是 ikusupuroa</h1>
      <p class="mt-5 text-lg leading-relaxed text-white/80">
        我是一個 Ubuntu 使用者。這個網站是我的 Ubuntu 技術筆記：追蹤 Canonical 與 Ubuntu 的官方消息，用繁體中文整理重點，也分享我為什麼推薦 Ubuntu。
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <section class="article-prose">
      <h2>為什麼做這個網站</h2>
      <p>
        Canonical 與 Ubuntu 的官方部落格每週都有不少新消息，從安全修補、新版本到雲端與 AI，但大多是英文，也不一定會說明「這件事跟我有什麼關係」。
      </p>
      <p>所以每篇文章我都分成兩個部分：</p>
      <ul>
        <li><strong>ikusupuroa 觀點</strong>：以 Ubuntu 使用者的角度，說明這件事值得注意的地方、要怎麼因應，以及 Ubuntu 在這方面做得好的地方。</li>
        <li><strong>原文精華導讀</strong>：把官方文章整理成繁體中文重點，技術名詞保留英文，並附上官方出處連結。</li>
      </ul>
      <p>這裡不是逐字翻譯，也不取代官方文件。版本、價格與支援政策，請以 Canonical 官方原文為準。</p>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold">我推薦 Ubuntu 的理由</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          reasons.map((item) => (
            <li class="rounded-2xl border border-stone-200 p-5 dark:border-white/10">
              <h3 class="text-lg font-bold text-ubuntu-orange">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold">文章是怎麼產生的</h2>
      <p class="mt-3 leading-relaxed text-stone-600 dark:text-stone-300">
        我用 Claude Code 協作撰稿：AI 負責速度，我負責判斷。
      </p>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          workflow.map((item) => (
            <li class="rounded-2xl border border-stone-200 p-5 dark:border-white/10">
              <div class="flex items-center justify-between">
                <span class="font-mono text-2xl font-bold text-ubuntu-orange">{item.step}</span>
                <span class="rounded-full bg-aubergine/10 px-2.5 py-0.5 text-xs text-aubergine dark:bg-white/10 dark:text-stone-200">
                  {item.who}
                </span>
              </div>
              <h3 class="mt-3 text-lg font-bold">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-14 rounded-2xl border border-ubuntu-orange/30 bg-ubuntu-orange-soft/50 p-6 dark:bg-ubuntu-orange/10">
      <h2 class="text-xl font-bold">寫作原則</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-stone-700 dark:text-stone-300">
        <li>每篇導讀都附上 Canonical 官方原文連結與作者資訊。</li>
        <li>技術名詞保留英文，並附繁體中文說明，例如 Livepatch（核心熱修補）。</li>
        <li>推薦 Ubuntu，但不誇大：原文沒寫、也查不到的內容，會標註「待確認」。</li>
        <li>觀點是我個人的看法，不代表 Canonical 官方意見。</li>
      </ul>
    </section>

    <p class="mt-10 text-sm text-stone-500 dark:text-stone-400">
      本站由 ikusupuroa 個人經營，與 Canonical Ltd. 無隸屬關係。Ubuntu 與 Canonical 為 Canonical Ltd. 之註冊商標。
      <a href={withBase('/articles/')} class="text-ubuntu-orange hover:underline">看全部文章 →</a>
    </p>
  </div>
</BaseLayout>
