---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LAB_ENV, SITE, withBase } from '../lib/site';

const reasons = [
  {
    title: '版本節奏清楚，可以學比較久',
    body: 'LTS 版本每兩年一版，標準支援 5 年，搭配 Ubuntu Pro 還能延長。用同一個版本就能學一段時間，不必一直追新版。',
  },
  {
    title: '遇到問題比較好查',
    body: '官方文件、教學與社群討論都不少，卡關時比較容易找到可以參考的資料。',
  },
  {
    title: '從筆電到雲端都能練習',
    body: '同一套系統可以裝在筆電、虛擬機或雲端主機上，練過的指令在不同環境大多用得上。',
  },
  {
    title: '官方消息可以當教材',
    body: 'Ubuntu 會公開安全公告與版本說明，跟著讀能順便了解漏洞怎麼被修補、新功能為什麼出現。',
  },
];

const workflow = [
  { step: '01', who: '自動', title: '監控官方消息', body: 'GitHub Actions 每小時檢查 Canonical Blog 與 Ubuntu Blog，有新文章就開 Issue 通知我。' },
  { step: '02', who: 'ikusupuroa', title: '挑選主題、動手實作', body: '從清單中挑出想深入了解的文章；技術筆記與套件功能則由我自己操作並截圖。' },
  { step: '03', who: 'Claude Code', title: 'AI 協助整理', body: 'Claude Code 閱讀官方原文或我的實作紀錄，整理成繁體中文初稿；查不到或沒交代清楚的內容會標註「待確認」。' },
  { step: '04', who: 'ikusupuroa', title: '確認與修正', body: '導讀文章上線後我再逐篇確認；實作文章我看過預覽才上線。發現錯誤就修改或下架。' },
];
---

<BaseLayout title="關於我" description={`關於 ${SITE.name}：一個選擇 Ubuntu 學習 Linux 的人，以及這個網站怎麼運作。`}>
  <section class="bg-aubergine-deep text-white">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <p class="font-mono text-sm tracking-widest text-ubuntu-orange-light">ABOUT ME</p>
      <h1 class="mt-3 text-3xl font-bold md:text-5xl">嗨，我是 ikusupuroa</h1>
      <p class="mt-5 text-lg leading-relaxed text-white/80">
        我正在學習 Linux，選擇 Ubuntu 作為學習路線。這個網站是我的學習筆記：整理 Canonical 與 Ubuntu 的官方消息，也記錄自己動手實作的過程。
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <section class="article-prose">
      <h2>為什麼做這個網站</h2>
      <p>
        學 Linux 的過程中，我發現官方部落格與技術文件大多是英文，資訊也比較分散。與其讀完就忘，不如把讀到的、試過的整理下來，方便自己回頭查，也許對同樣在學的人有點幫助。
      </p>
      <p>網站目前分成三個部分：</p>
      <ul>
        <li>
          <strong>精華導讀</strong>：整理 Canonical 與 Ubuntu 官方文章的重點。每篇分成「ikusupuroa 觀點」（我讀完後的想法與疑問）和「原文精華導讀」（官方原文的繁體中文重點與出處）。
        </li>
        <li><strong>技術筆記</strong>：學習過程中注意到的議題，查看 Ubuntu 提供的解決方式，自己動手試一次。</li>
        <li><strong>Ubuntu 套件功能</strong>：認識 Canonical 推出的套件與產品，對照官方技術文件實際操作。</li>
      </ul>
      <p>
        這裡不是逐字翻譯，也不取代官方文件。我還在學習，內容可能有錯或不完整，版本、價格與支援政策請以 Canonical 官方說明為準。
      </p>
    </section>

    <section id="lab-env" class="mt-14 scroll-mt-24">
      <h2 class="text-2xl font-bold">我的測試環境</h2>
      <p class="mt-3 leading-relaxed text-stone-600 dark:text-stone-300">
        技術筆記與套件功能的實作，是在我自己的筆電上操作的。這台筆電是別人汰換下來、我買來的二手機，規格不算新，目前用來練習 Ubuntu Desktop 與 LXD 容器。需要其他 Ubuntu 版本時，會另外開容器或虛擬機測試，各篇文章開頭會列出當次實際使用的環境。
      </p>
      <dl class="mt-6 divide-y divide-stone-200 overflow-hidden rounded-2xl border border-stone-200 dark:divide-white/10 dark:border-white/10">
        {
          LAB_ENV.specs.map((item) => (
            <div class="grid gap-1 px-5 py-3.5 sm:grid-cols-[7rem_1fr] sm:gap-4">
              <dt class="text-sm font-bold text-ubuntu-orange">{item.label}</dt>
              <dd class="text-sm leading-relaxed text-stone-700 dark:text-stone-300">
                {Array.isArray(item.value) ? (
                  <ol class="list-decimal space-y-1 pl-5">
                    {item.value.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ol>
                ) : (
                  item.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">規格資訊整理於 {LAB_ENV.updated}，之後如有升級會更新。</p>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold">我選擇 Ubuntu 學 Linux 的原因</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          reasons.map((item) => (
            <li class="rounded-2xl border border-stone-200 p-5 dark:border-white/10">
              <h3 class="text-lg font-bold text-ubuntu-orange">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{item.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-stone-500 dark:text-stone-400">這是我個人的選擇，其他 Linux 發行版也各有優點。</p>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold">文章是怎麼產生的</h2>
      <p class="mt-3 leading-relaxed text-stone-600 dark:text-stone-300">
        我用 Claude Code 協助整理文字；選題、實作與最後確認由我自己負責。
      </p>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          workflow.map((item) => (
            <li class="rounded-2xl border border-stone-200 p-5 dark:border-white/10">
              <div class="flex items-center justify-between">
                <span class="font-mono text-2xl font-bold text-ubuntu-orange">{item.step}</span>
                <span class="rounded-full bg-aubergine/10 px-2.5 py-0.5 text-xs text-aubergine dark:bg-white/10 dark:text-stone-200">
                  {item.who}
                </span>
              </div>
              <h3 class="mt-3 text-lg font-bold">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-14 rounded-2xl border border-ubuntu-orange/30 bg-ubuntu-orange-soft/50 p-6 dark:bg-ubuntu-orange/10">
      <h2 class="text-xl font-bold">寫作原則</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-stone-700 dark:text-stone-300">
        <li>每篇導讀都附上 Canonical 官方原文連結與作者資訊。</li>
        <li>技術名詞保留英文，並附繁體中文說明，例如 Livepatch（核心熱修補）。</li>
        <li>以學習者的角度記錄，不誇大：原文沒寫、也查不到的內容，會標註「待確認」。</li>
        <li>觀點是我學習過程中的個人想法，可能有錯，也不代表 Canonical 官方意見；發現錯誤歡迎指正。</li>
      </ul>
    </section>

    <p class="mt-10 text-sm text-stone-500 dark:text-stone-400">
      本站由 ikusupuroa 個人經營，與 Canonical Ltd. 無隸屬關係。Ubuntu 與 Canonical 為 Canonical Ltd. 之註冊商標。
      <a href={withBase('/articles/')} class="text-ubuntu-orange hover:underline">看全部文章 →</a>
    </p>
  </div>
</BaseLayout>
